/* ============ 鲜记 · 冰箱清单页 ============ */

/* ---- Hero 头部：手账标题 + 日期 + 一句话摘要 ---- */
.hero {
  padding: 28rpx 32rpx 4rpx;
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.hero-brand {
  font-size: 26rpx;
  color: #6E6656;
  letter-spacing: 4rpx;
}
.hero-date {
  font-size: 26rpx;
  color: #A79E8C;
  letter-spacing: 2rpx;
}
.hero-tip {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #29241C;
  letter-spacing: 2rpx;
}

/* ---- 统计卡：三个衬线大数字 + 虚线分隔 ---- */
.stats {
  display: flex;
  align-items: center;
  padding: 32rpx 20rpx;
}
.stat { flex: 1; text-align: center; }
.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}
.stat-num.ink { color: #29241C; }
.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A79E8C;
  letter-spacing: 3rpx;
}
.stat-div {
  width: 2rpx;
  height: 64rpx;
  border-left: 2rpx dashed #EAE2D2;
}

/* ---- 横滑区块标题 ---- */
.block { margin-top: 28rpx; }
.block-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 0 32rpx 16rpx;
  letter-spacing: 2rpx;
  color: #29241C;
}
.h-scroll { white-space: nowrap; padding: 4rpx 24rpx; box-sizing: border-box; }

/* ---- 今天该吃：状态色贴纸卡 ---- */
.ef-item {
  display: inline-flex;
  flex-direction: column;
  width: 208rpx;
  margin-right: 20rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #FFFDF8;
  border: 2rpx solid #EFE7D6;
  box-shadow: 0 6rpx 16rpx rgba(96, 74, 32, 0.06);
  vertical-align: top;
}
.ef-item.ef-expired { background: #FFF9F5; border-color: #F0D5C9; }
.ef-item.ef-expiring { background: #FFFBF2; border-color: #F0E2C4; }
.ef-item.ef-fresh { background: #F8FBF5; border-color: #DCE8D5; }
.ef-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ef-icon { font-size: 44rpx; }
.ef-days { font-size: 26rpx; font-weight: 700; }
.ef-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 12rpx;
  color: #29241C;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ef-suggest {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A79E8C;
}

/* ---- 菜谱：食谱小卡 ---- */
.rec-tip {
  font-size: 22rpx;
  color: #A79E8C;
  margin-left: 12rpx;
  letter-spacing: 1rpx;
  font-weight: 400;
}
.rec-item {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 220rpx;
  height: 132rpx;
  margin-right: 20rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #2E5C3E;
  box-shadow: 0 8rpx 18rpx rgba(46, 92, 62, 0.22);
  vertical-align: top;
}
.rec-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #FFFDF8;
  letter-spacing: 1rpx;
}
.rec-sub {
  font-size: 22rpx;
  color: rgba(255, 253, 248, 0.75);
  margin-top: 8rpx;
}
.rec-sub.status-expiring { color: #F5C87E; }

/* ---- 筛选 Chips ---- */
.chips {
  white-space: nowrap;
  padding: 20rpx 16rpx 4rpx;
}
.chip {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin: 0 8rpx;
  border-radius: 999rpx;
  background: #FFFDF8;
  border: 2rpx solid #EFE7D6;
  color: #6E6656;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}
.chip-on {
  background: #2E5C3E;
  border-color: #2E5C3E;
  color: #FFFDF8;
  font-weight: 600;
}
.chip-more { color: #2E5C3E; border-color: #CBDCC9; }

/* ---- 分组标题：色点 + 衬线标题 + 数量 ---- */
.sec-title {
  display: flex;
  align-items: center;
  margin: 36rpx 32rpx 6rpx;
}
.sec-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.dot-expired { background: #C0452F; }
.dot-expiring { background: #DE8A2D; }
.dot-fresh { background: #4E9A5F; }
.sec-name {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #29241C;
}
.sec-count {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #A79E8C;
}

/* ---- 空状态 / 页脚 / 提示 ---- */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-icon { font-size: 110rpx; }
.empty-title {
  font-size: 38rpx;
  font-weight: 700;
  margin: 24rpx 0 10rpx;
  letter-spacing: 3rpx;
  color: #29241C;
}
.empty-sub { color: #A79E8C; font-size: 25rpx; }
.empty-btn { margin-top: 48rpx; width: 56%; }

.foot {
  text-align: center;
  padding: 36rpx 0 64rpx;
  color: #C5BCA8;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.expired-hint {
  margin: 4rpx 32rpx 16rpx;
  font-size: 22rpx;
  color: #C0452F;
  opacity: 0.75;
}