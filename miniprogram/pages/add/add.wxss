.shoot-empty { text-align: center; padding: 60rpx 0; }
.shoot-icon { font-size: 90rpx; }
.shoot-title { font-size: 32rpx; font-weight: 600; margin: 16rpx 0 8rpx; }
.photo { width: 100%; height: 420rpx; border-radius: 16rpx; }
.photo-tip { text-align: center; margin-top: 10rpx; }

.loading-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 8rpx;
  color: #07c160;
}
.loading-spin {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #d8eee2;
  border-top-color: #07c160;
  border-radius: 50%;
  margin-right: 12rpx;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.ai-error {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fff7f0;
  border-radius: 12rpx;
  color: #d8622a;
  font-size: 26rpx;
}
.ai-error-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.scene { margin-top: 16rpx; }

.row-card .row-head { display: flex; align-items: center; }
.row-icon { font-size: 40rpx; margin-right: 12rpx; }
.row-name { flex: 1; font-size: 32rpx; font-weight: 600; }
.manual-name { border-bottom: 2rpx solid #eee; padding: 8rpx 0; }
.tag-adj { background: #fff3e0; color: #d8622a; }
.tag-ok { background: #e8f8ef; color: #07c160; }

.row-form {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 20rpx 0;
  font-size: 28rpx;
}
.form-item { padding: 10rpx 0; }
.form-val { color: #07c160; font-weight: 600; }
.days-item { display: flex; align-items: center; }
.days-input {
  width: 100rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 6rpx 10rpx;
  text-align: center;
  margin: 0 8rpx;
}
.row-note {
  border-bottom: 2rpx solid #f0f0f0;
  padding: 12rpx 0 8rpx;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.save-btn { margin-top: 20rpx; }
.save-all { margin: 30rpx 24rpx 0; }
.go-index { margin: 20rpx 24rpx 0; }

.manual-toggle {
  text-align: center;
  color: #07c160;
  padding: 30rpx 0 10rpx;
  font-size: 28rpx;
}
.sug-list { margin-top: 16rpx; }
.sug {
  padding: 14rpx 8rpx;
  border-bottom: 2rpx solid #f5f5f5;
  font-size: 28rpx;
}

.recent { padding: 20rpx 24rpx; }
.recent-title { margin-bottom: 12rpx; }
.recent-chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.recent-chip {
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: #f2fbf6;
  color: #07c160;
  border: 2rpx solid #d8f0e2;
  font-size: 26rpx;
}
