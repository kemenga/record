<view class="card add-row">
  <input class="add-input" value="{{inputName}}" bindinput="onInput" bindconfirm="onAdd" placeholder="要买什么？如：牛奶" confirm-type="done" />
  <button size="mini" class="btn-primary" bind:tap="onAdd">加入</button>
</view>

<view wx:if="{{recentEaten.length}}" class="card sug">
  <view class="muted">最近吃完的（点击补货）：</view>
  <view class="sug-chips">
    <view wx:for="{{recentEaten}}" wx:key="*this" class="sug-chip" data-name="{{item}}" bind:tap="onQuickAdd">{{item}}</view>
  </view>
</view>

<view wx:if="{{items.length}}" class="card list">
  <view class="list-title">待购 <text class="muted">（{{items.length}}）</text></view>
  <view wx:for="{{items}}" wx:key="id" class="s-item">
    <view class="s-check" data-id="{{item.id}}" bind:tap="onToggle">○</view>
    <text class="s-name">{{item.name}}</text>
    <text class="s-del" data-id="{{item.id}}" bind:tap="onRemove">✕</text>
  </view>
</view>
<view wx:else class="empty-tip muted">清单空了，购物愉快 🛒</view>

<block wx:if="{{doneItems.length}}">
  <view class="card list">
    <view class="list-title">已买 <text class="muted">（{{doneItems.length}}）</text></view>
    <view wx:for="{{doneItems}}" wx:key="id" class="s-item s-done">
      <view class="s-check s-checked" data-id="{{item.id}}" bind:tap="onToggle">●</view>
      <text class="s-name">{{item.name}}</text>
      <text class="s-del" data-id="{{item.id}}" bind:tap="onRemove">✕</text>
    </view>
    <button size="mini" class="btn-primary buy-btn" bind:tap="onBuyIntoFridge">全部放入冰箱（按建议保鲜期）</button>
  </view>
</block>
