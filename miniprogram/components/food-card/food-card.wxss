/* 鲜记 · 食物卡片 —— 冰箱贴便签风格 */
.fc {
  margin: 16rpx 24rpx;
  position: relative;
  transition: transform 0.15s ease;
}

.fc-main {
  display: flex;
  align-items: center;
}

/* 图标：状态色系浅底圆角方块，像一枚小贴纸 */
.fc-icon {
  font-size: 44rpx;
  margin-right: 22rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.fc-icon-expired { background: #FBEAE3; }
.fc-icon-expiring { background: #FBF1DE; }
.fc-icon-fresh { background: #E7F3E8; }

.fc-info { flex: 1; overflow: hidden; }

.fc-name-row {
  display: flex;
  align-items: center;
}

.fc-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 300rpx;
  color: #29241C;
}

/* 分区小胶囊 */
.fc-zone {
  font-size: 20rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: #F3EDDE;
  color: #6E6656;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.fc-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #A79E8C;
}

.fc-days {
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
  margin-left: 16rpx;
}

/* 保鲜进度条：米白轨道 + 状态色渐变 */
.fc-bar-wrap {
  height: 10rpx;
  background: #F1EADA;
  border-radius: 999rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.fc-bar { height: 100%; border-radius: 999rpx; transition: width 0.3s; }

.fc-tips {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #EAE2D2;
  font-size: 23rpx;
  color: #A79E8C;
}

/* 已过期：番茄红虚线边框，像盖了"尽快处理"章 */
.fc-expired {
  border: 2rpx dashed #D89A8B;
  background: #FFF9F5;
}
.fc-opened {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #8a6d1a;
  background: #f7edd2;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
}

.fc-low {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #a8433a;
  background: #f9e4e0;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
}

.fc { position: relative; }
.fc-select {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border: 3rpx solid #cfd6d0;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
}
.fc-check-on { background: #2E5C3E; border-color: #2E5C3E; }
.fc-selected { outline: 3rpx solid #2E5C3E; }
