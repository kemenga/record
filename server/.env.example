# 复制本文件为 server/.env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 注意：.env 的值会覆盖系统环境变量（避免 shell 中残留的旧 ARK_API_KEY 导致鉴权失败）
# 火山方舟 API Key（必填）：https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=
# 可选：接入点或模型 ID，默认 glm-5.3-flash（也支持 doubao-seed-1-6-vision 等，需配套换 Base URL）
ARK_MODEL=glm-5.3-flash
# 可选：默认 https://ark.cn-beijing.volces.com/api/coding/v3（Coding Plan 端点；doubao 等正式端点为 .../api/v3）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 可选：思考力度 low|medium|high（默认 low，识别任务够用且更快；留空则不传该参数）
ARK_REASONING_EFFORT=low
# 可选：本地监听端口，默认 3000（命令行 --port 9201 可临时覆盖一切配置）
PORT=3000
