.eat-first { padding-bottom: 16rpx; }
.ef-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.ef-scroll { white-space: nowrap; }
.ef-item {
  display: inline-flex;
  flex-direction: column;
  width: 200rpx;
  margin-right: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fafbfc;
  border: 2rpx solid #f0f1f2;
}
.ef-icon { font-size: 40rpx; }
.ef-name { font-size: 28rpx; font-weight: 600; margin: 6rpx 0 2rpx; }
.ef-days { font-size: 26rpx; font-weight: 700; }
.ef-suggest { font-size: 22rpx; }

.stats {
  display: flex;
  margin-top: 20rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num { font-size: 44rpx; font-weight: 700; }

.chips {
  white-space: nowrap;
  padding: 8rpx 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin: 0 10rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
}

.chip-on {
  background: #07c160;
  color: #fff;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 100rpx; }

.empty-title { font-size: 34rpx; font-weight: 600; margin: 20rpx 0 8rpx; }

.empty-btn { margin-top: 40rpx; width: 60%; }

.foot { text-align: center; padding: 30rpx 0 60rpx; }

.expired-hint {
  margin: 8rpx 32rpx 16rpx;
  font-size: 22rpx;
}
