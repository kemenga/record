.add-row { display: flex; align-items: center; gap: 16rpx; }
.add-input {
  flex: 1;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
}

.sug { padding: 20rpx 24rpx; }
.sug-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }
.sug-chip {
  padding: 8rpx 24rpx;
  border-radius: 26rpx;
  background: #f2fbf6;
  color: #2E5C3E;
  border: 2rpx solid #d8f0e2;
  font-size: 26rpx;
}

.list-title { font-size: 30rpx; font-weight: 600; margin-bottom: 14rpx; }
.s-item {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
  border-bottom: 2rpx solid #f5f5f5;
}
.s-check {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border: 3rpx solid #cfd6d0;
  border-radius: 50%;
  margin-right: 20rpx;
  color: #2E5C3E;
  font-size: 24rpx;
  flex-shrink: 0;
}
.s-checked { background: #2E5C3E; color: #fff; border-color: #2E5C3E; }
.s-name { flex: 1; font-size: 30rpx; }
.s-done .s-name { color: #999; text-decoration: line-through; }
.s-del { color: #bbb; padding: 0 16rpx; font-size: 30rpx; }
.buy-btn { margin-top: 24rpx; }
.empty-tip { text-align: center; padding: 100rpx 0; }
