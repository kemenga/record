<view class="fc card {{item.status === 'expired' ? 'fc-expired' : ''}}" bind:tap="onTap">
  <view class="fc-main">
    <view class="fc-icon">{{item.categoryIcon}}</view>
    <view class="fc-info">
      <view class="fc-name-row">
        <text class="fc-name">{{item.name}}</text>
        <text class="tag">{{item.zoneLabel}}</text>
      </view>
      <view class="fc-sub muted">{{item.categoryLabel}} · 入库 {{item.addedText}}</view>
    </view>
    <view class="fc-days status-{{item.status}}">{{item.daysText}}</view>
  </view>
  <view class="fc-bar-wrap">
    <view class="fc-bar bg-{{item.status}}" style="width: {{item.progressPercent}}%"></view>
  </view>
  <view wx:if="{{item.tips}}" class="fc-tips muted">{{item.tips}}</view>
</view>
