<!-- 鲜记 · 食物详情 -->
<view wx:if="{{food}}" class="card hero rise-in hero-{{food.status}}">
  <view class="hero-top">
    <view class="hero-icon hero-icon-{{food.status}}">{{food.categoryIcon}}</view>
    <view class="hero-info">
      <view class="hero-name serif">{{food.name}}</view>
      <view class="hero-meta">{{food.categoryLabel}} · {{food.zoneLabel}} · {{food.sourceText}}</view>
    </view>
  </view>
  <view class="hero-status-row">
    <view class="hero-days-wrap">
      <view class="hero-days serif status-{{food.status}}">{{food.daysText}}</view>
      <view class="hero-status-pill pill-{{food.status}}">{{food.statusText}}</view>
    </view>
  </view>
  <view class="bar-wrap">
    <view class="bar bg-{{food.status}}" style="width: {{food.progressPercent}}%"></view>
  </view>
  <view class="bar-legend">
    <text>入库 {{food.addedText}}</text>
    <text>建议用完 {{food.expiryText}}</text>
  </view>
  <view wx:if="{{food.openedText}}" class="opened-badge">🔓 {{food.openedText}}</view>
  <view wx:if="{{food.guideText}}" class="tips">🏠 {{food.guideText}}</view>
  <view wx:if="{{food.historyText}}" class="tips">🔀 转移记录：{{food.historyText}}</view>
  <view wx:if="{{food.confidenceText}}" class="conf">{{food.confidenceText}} · {{food.sourceText}}</view>
  <view wx:if="{{food.tips}}" class="tips">💡 {{food.tips}}</view>
  <view wx:if="{{food.note}}" class="tips tips-note">📝 {{food.note}}</view>
  <view class="nutri">
    <view class="nutri-head">🥗 营养成份（每100g可食部）<text class="nutri-src">{{food.nutritionSource}}</text></view>
    <view class="nutri-grid">
      <view class="nutri-cell"><text class="nutri-num">{{food.nutrition.kcal}}</text><text class="nutri-lab">千卡</text></view>
      <view class="nutri-cell"><text class="nutri-num">{{food.nutrition.protein}}g</text><text class="nutri-lab">蛋白质</text></view>
      <view class="nutri-cell"><text class="nutri-num">{{food.nutrition.fat}}g</text><text class="nutri-lab">脂肪</text></view>
      <view class="nutri-cell"><text class="nutri-num">{{food.nutrition.carbs}}g</text><text class="nutri-lab">碳水</text></view>
      <view class="nutri-cell"><text class="nutri-num">{{food.nutrition.fiber}}g</text><text class="nutri-lab">纤维</text></view>
    </view>
    <view class="nutri-note">估算值仅供参考，具体以实际食材为准</view>
  </view>
</view>

<view wx:if="{{food && !editing}}" class="actions">
  <button class="btn-primary act" bind:tap="onToggleEdit">修改名称 / 分区 / 天数</button>
  <button wx:if="{{!food.opened}}" class="btn-plain act" bind:tap="onOpenFood">🔓 标记已开封</button>
  <button class="btn-plain act" bind:tap="onQuantity">📦 剩余量{{food.quantityLabel ? '：' + food.quantityLabel : ''}}</button>
  <button class="btn-plain act" bind:tap="onTransfer">🔀 转移分区</button>
  <button class="btn-plain act" bind:tap="onEaten">🍽 标记已食用</button>
  <button class="btn-warn act" bind:tap="onDelete">删除记录</button>
</view>

<view wx:if="{{editing}}" class="card rise-in">
  <view class="edit-title serif">编辑<view class="edit-sub">天数按"从今天起还能存放"计算</view></view>
  <input class="edit-name" value="{{editName}}" bindinput="onEditName" placeholder="食物名称" />
  <picker mode="selector" range="{{zoneLabels}}" value="{{editZoneIndex}}" bindchange="onEditZone">
    <view class="edit-row">存放分区：<text class="edit-val">{{zoneLabels[editZoneIndex]}}</text>（点击切换）</view>
  </picker>
  <view class="edit-row days-row">
    <text>保鲜天数：</text>
    <input class="days-input" type="number" value="{{editDays}}" bindblur="onEditDays" />
    <text> 天</text>
  </view>
  <view class="edit-actions">
    <button class="btn-primary act" bind:tap="onEditSave">保存修改</button>
    <button class="btn-plain act" bind:tap="onToggleEdit">取消</button>
  </view>
</view>