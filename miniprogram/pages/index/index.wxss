.stats {
  display: flex;
  margin-top: 20rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num { font-size: 44rpx; font-weight: 700; }

.chips {
  white-space: nowrap;
  padding: 8rpx 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin: 0 10rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
}

.chip-on {
  background: #07c160;
  color: #fff;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 100rpx; }

.empty-title { font-size: 34rpx; font-weight: 600; margin: 20rpx 0 8rpx; }

.empty-btn { margin-top: 40rpx; width: 60%; }

.foot { text-align: center; padding: 30rpx 0 60rpx; }
