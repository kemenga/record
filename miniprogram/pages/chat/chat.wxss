page { height: 100%; }
.chat-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F1E7;
}

.chat-scroll { flex: 1; padding: 20rpx 0; box-sizing: border-box; }

.row { display: flex; padding: 12rpx 24rpx; }
.row-user { flex-direction: row-reverse; }
.avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #fff; text-align: center; line-height: 64rpx;
  font-size: 34rpx; flex-shrink: 0;
}
.bubble {
  max-width: 76%;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.bubble-ai { background: #FFFDF8; color: #333; margin-left: 16rpx; }
.bubble-user { background: #2E5C3E; color: #fff; margin-right: 16rpx; }
.bubble-user .bubble-text { color: #fff; }
.bubble-img { width: 320rpx; height: 240rpx; border-radius: 12rpx; margin-top: 12rpx; }
.cmd-line { margin-top: 10rpx; font-size: 24rpx; }
.cmd-ok { color: #2E5C3E; }
.cmd-fail { color: #e64340; }
.typing { color: #999; }
.chat-pad-bottom { height: 30rpx; }

.quick {
  display: flex; flex-wrap: wrap; gap: 14rpx;
  margin: 0 24rpx 16rpx;
  padding: 18rpx 20rpx;
}
.quick-chip {
  font-size: 24rpx; color: #2E5C3E;
  background: #e8f4ec; border: 2rpx solid #d8f0e2;
  border-radius: 26rpx; padding: 8rpx 22rpx;
}

.composer { margin: 0 24rpx 24rpx; padding: 16rpx 20rpx; }
.preview {
  width: 140rpx; height: 140rpx; border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.composer-row { display: flex; align-items: center; gap: 14rpx; }
.attach { font-size: 40rpx; padding: 0 6rpx; }
.composer-input {
  flex: 1;
  border: 2rpx solid #eee;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
}
.send-btn { flex-shrink: 0; }
