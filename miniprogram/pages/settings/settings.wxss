.s-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.mode-row { display: flex; gap: 16rpx; }
.mode {
  flex: 1;
  border: 3rpx solid #eee;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 24rpx;
}
.mode-on { border-color: #07c160; background: #f2fbf6; }
.mode-name { font-size: 28rpx; font-weight: 600; margin-bottom: 6rpx; }

.s-label { font-size: 26rpx; color: #666; margin: 20rpx 0 8rpx; }
.s-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
}
.check-btn { margin-top: 16rpx; }
.health { margin-top: 12rpx; }
.s-tip { margin-top: 14rpx; line-height: 1.6; }
.days-row { display: flex; align-items: center; gap: 10rpx; }
.days-input { width: 120rpx; text-align: center; }

.deploy-guide { margin-top: 8rpx; }
.dg-title { font-size: 28rpx; font-weight: 600; margin-bottom: 10rpx; }
.dg-step { font-size: 26rpx; color: #555; line-height: 1.8; }
.dg-code {
  display: inline-block;
  background: #f2f3f5;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 24rpx;
  color: #07c160;
}
.dg-note { margin-top: 12rpx; }

.data-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
