.search-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
}
.rec-head { display: flex; align-items: flex-start; }
.rec-main { flex: 1; }
.rec-title { font-size: 32rpx; font-weight: 600; }
.rec-ok {
  font-size: 20rpx; color: #fff; background: #2E5C3E;
  border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx; font-weight: 400;
}
.rec-part {
  font-size: 20rpx; color: #8a6d1a; background: #f7edd2;
  border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx; font-weight: 400;
}
.rec-none {
  font-size: 20rpx; color: #999; background: #f2f3f5;
  border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx; font-weight: 400;
}
.rec-ings { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.rec-ing { font-size: 24rpx; border-radius: 8rpx; padding: 4rpx 12rpx; }
.rec-ing-have { background: #e8f4ec; color: #2E5C3E; }
.rec-ing-miss { background: #f4f1ea; color: #b5ae9e; }
.rec-warn { margin-top: 10rpx; font-size: 24rpx; }
.rec-arrow { color: #b5ae9e; margin-left: 16rpx; font-size: 24rpx; padding-top: 6rpx; }
.rec-detail { margin-top: 20rpx; border-top: 2rpx solid #f0ede6; padding-top: 18rpx; }
.rec-d-title { font-size: 26rpx; font-weight: 600; margin: 12rpx 0 8rpx; }
.rec-d-ings { display: flex; flex-wrap: wrap; gap: 10rpx; }
.rec-steps { font-size: 28rpx; line-height: 1.7; color: #444; }
.empty-tip { text-align: center; color: #999; }
